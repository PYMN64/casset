# Casset environment template
# Copy to .env for local development. Never commit real secrets.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# Database
# Local default remains SQLite. Use DB_ENGINE=postgresql for PostgreSQL.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Cache
REDIS_URL=

# Plays anti-fraud
PLAY_IP_SALT=change-me
PLAY_UA_SALT=change-me
PLAY_COUNT_AFTER_SECONDS=59

# Uploads
CREATOR_DAILY_UPLOAD_LIMIT=10

# Production security controls
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
