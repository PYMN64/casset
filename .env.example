# Casset environment template
# ------------------------------------------------
# 1. Copy this file:  cp .env.example .env
# 2. Fill in the values below
# 3. NEVER commit .env to git
# ------------------------------------------------

# Settings module
# dev  → config.settings.dev
# prod → config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# --------------------------------------------------------------------
# REQUIRED SECRETS — generate with: python -c "import secrets; print(secrets.token_hex(48))"
# In dev these auto-generate if missing (with a warning).
# In prod startup will FAIL if any of these is empty.
# --------------------------------------------------------------------
DJANGO_SECRET_KEY=
PLAY_IP_SALT=
PLAY_UA_SALT=

# --------------------------------------------------------------------
# Django core
# --------------------------------------------------------------------
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Tehran
DJANGO_LOG_LEVEL=INFO

# --------------------------------------------------------------------
# Database
# DB_ENGINE: sqlite (default) | postgresql
# Production (config.settings.prod) REQUIRES DB_ENGINE=postgresql — startup
# fails otherwise. DB_PASSWORD is also required in prod (fails if empty).
# --------------------------------------------------------------------
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
# sslmode for the Postgres connection (ignored for sqlite): disable | allow |
# prefer | require | verify-ca | verify-full. Dev defaults to "prefer"; prod
# defaults to "require" unless you set this explicitly (e.g. "disable" on a
# trusted private VPC link).
DB_SSLMODE=
# Seconds to wait for a DB TCP connection before giving up.
DB_CONNECT_TIMEOUT=10

# --------------------------------------------------------------------
# Cache / Redis (optional — in-memory fallback used if empty)
# --------------------------------------------------------------------
REDIS_URL=

# --------------------------------------------------------------------
# Play anti-fraud
# --------------------------------------------------------------------
PLAY_COUNT_AFTER_SECONDS=59

# --------------------------------------------------------------------
# Upload limits: free_upload_minutes / creator_daily_upload_limit are
# admin-editable via PlatformSetting (Django admin), not env vars.
# --------------------------------------------------------------------

# --------------------------------------------------------------------
# Production-only security (ignored in dev)
# --------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
