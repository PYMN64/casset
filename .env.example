# Casset environment template
# ------------------------------------------------
# 1. Copy this file:  cp .env.example .env
# 2. Fill in the values below
# 3. NEVER commit .env to git
# ------------------------------------------------

# Settings module
# dev  → config.settings.dev
# prod → config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# --------------------------------------------------------------------
# REQUIRED SECRETS — generate with: python -c "import secrets; print(secrets.token_hex(48))"
# In dev these auto-generate if missing (with a warning).
# In prod startup will FAIL if any of these is empty.
# --------------------------------------------------------------------
DJANGO_SECRET_KEY=
PLAY_IP_SALT=
PLAY_UA_SALT=

# --------------------------------------------------------------------
# Django core
# --------------------------------------------------------------------
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Tehran
DJANGO_LOG_LEVEL=INFO

# --------------------------------------------------------------------
# Database
# DB_ENGINE: sqlite (default) | postgresql
# Production (config.settings.prod) REQUIRES DB_ENGINE=postgresql — startup
# fails otherwise. DB_PASSWORD is also required in prod (fails if empty).
# --------------------------------------------------------------------
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
# sslmode for the Postgres connection (ignored for sqlite): disable | allow |
# prefer | require | verify-ca | verify-full. Dev defaults to "prefer"; prod
# defaults to "require" unless you set this explicitly (e.g. "disable" on a
# trusted private VPC link).
DB_SSLMODE=
# Seconds to wait for a DB TCP connection before giving up.
DB_CONNECT_TIMEOUT=10

# --------------------------------------------------------------------
# Cache / Redis (optional — in-memory fallback used if empty)
# Also the Celery broker/result backend — see CELERY_TASK_ALWAYS_EAGER below.
# --------------------------------------------------------------------
REDIS_URL=

# --------------------------------------------------------------------
# Celery — async task queue (currently: follower fan-out notifications).
# Defaults to eager (synchronous, in-process) when REDIS_URL is empty, which
# is what dev/test use. Set explicitly to override the auto default.
# In prod, run a real worker: celery -A config worker --loglevel=info
# --------------------------------------------------------------------
CELERY_TASK_ALWAYS_EAGER=

# --------------------------------------------------------------------
# Scheduled database backup (core/tasks.py::backup_database_task, via
# CELERY_BEAT_SCHEDULE — needs `celery -A config beat` running in prod, same
# as the weekly digest above). Uploads to the configured object storage
# (USE_S3_STORAGE) under backups/. Defaults to 03:00 daily.
# --------------------------------------------------------------------
BACKUP_SCHEDULE_HOUR=3
BACKUP_SCHEDULE_MINUTE=0

# --------------------------------------------------------------------
# Error tracking (optional) — Sentry. Only initialized in prod.py when set.
# --------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# --------------------------------------------------------------------
# Email (optional) — used for the creator weekly digest
# (notifications/tasks.py::send_creator_weekly_digest, scheduled via
# CELERY_BEAT_SCHEDULE — needs `celery -A config beat` running in prod).
# Falls back to the console backend (logs only) when EMAIL_HOST is empty.
# --------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Casset <no-reply@casset.ir>

# --------------------------------------------------------------------
# Play anti-fraud
# --------------------------------------------------------------------
PLAY_COUNT_AFTER_SECONDS=59

# --------------------------------------------------------------------
# SMS (OTP delivery) — console (dev/test, logs only) | kavenegar (real SMS)
# Production requires SMS_PROVIDER=kavenegar + KAVENEGAR_API_KEY, or startup
# fails. Get an API key at https://panel.kavenegar.com.
# --------------------------------------------------------------------
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# --------------------------------------------------------------------
# Payment gateway — dev (no real charges, activate_vip_dev/start_payment
# both simulate success) | zarinpal (real Iranian payment gateway).
# Production requires PAYMENT_PROVIDER=zarinpal + ZARINPAL_MERCHANT_ID.
# Get a merchant ID at https://next.zarinpal.com (sandbox available for
# testing without a real business account — set ZARINPAL_SANDBOX=1).
# --------------------------------------------------------------------
PAYMENT_PROVIDER=dev
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0

# --------------------------------------------------------------------
# Upload limits: free_upload_minutes / creator_daily_upload_limit are
# admin-editable via PlatformSetting (Django admin), not env vars.
# --------------------------------------------------------------------

# --------------------------------------------------------------------
# Object storage (media files) — optional, S3-compatible (Arvan Cloud,
# Liara, MinIO, AWS S3, ...). Ignored unless USE_S3_STORAGE=1. dev.py always
# uses local disk regardless of these. When enabled in prod, the four S3_*
# vars below (except S3_REGION/S3_CUSTOM_DOMAIN, which are optional) are
# required or startup fails.
# --------------------------------------------------------------------
USE_S3_STORAGE=0
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION=
S3_CUSTOM_DOMAIN=

# --------------------------------------------------------------------
# Production-only security (ignored in dev)
# --------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
